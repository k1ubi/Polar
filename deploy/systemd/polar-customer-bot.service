[Unit]
Description=Polar - Customer Telegram bot (registration + signal notifications)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/kyubi/Polar
ExecStart=/usr/bin/python3 -m Core.customer_bot.bot
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
