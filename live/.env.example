# Polar — runtime credentials
# Copy this to live/.env and fill in your values. Never commit live/.env.

# Telegram bots (create via @BotFather)
TG_BOT_TOKEN=your_main_bot_token_here        # @polar_aibot — Lorenzo's control bot
TG_CHAT_ID=your_telegram_chat_id_here        # Lorenzo's Telegram user ID
TG_USER_BOT_TOKEN=your_user_bot_token_here   # @polar_user_bot — customer copy-trading bot

# Bitget USDT-M futures API
# Create at Bitget → User Center → API Management
# Required scopes: Read + Trade (Futures)
BITGET_API_KEY=your_api_key_here
BITGET_SECRET=your_api_secret_here
BITGET_PASSPHRASE=your_api_passphrase_here
