# Copy to .env and fill in real values.

# ── Bitget API ────────────────────────────────────────────────────────────────
BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSPHRASE=

# ── Telegram (admin bot) ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ── Telegram (customer bot) ───────────────────────────────────────────────────
TELEGRAM_CUSTOMER_BOT_TOKEN=

# ── Trading mode ──────────────────────────────────────────────────────────────
# Set to false to put all Cores in paper mode globally
POLAR_LIVE_TRADING=true
# Per-Core override (uncomment to pause only VPA without touching other Cores)
# POLAR_LIVE_TRADING_VPA=false
